<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revara fork: tests of plugin/Core/MessageFramer.cs with no Revit reference, so they run on any OS.
       Kept out of mcp-servers-for-revit.sln so the add-in build does not change. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\plugin\Core\MessageFramer.cs" Link="MessageFramer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
